{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Company month project v8",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "month", "dataset", "target", "input", "defaults", "sources"],
  "properties": {
    "version": {"const": 8},
    "month": {"type": "string", "pattern": "^\\d{4}-(0[1-9]|1[0-2])$"},
    "dataset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["company_key", "company_id", "company_name"],
      "properties": {
        "company_key": {"type": "string", "pattern": "^company_[A-Za-z0-9_-]+$"},
        "company_id": {"type": "string", "minLength": 1},
        "company_name": {"type": "string", "minLength": 1}
      }
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["accountbook_key", "company_id", "company_name"],
      "properties": {
        "accountbook_key": {"type": "string", "minLength": 1},
        "company_id": {"type": "string", "minLength": 1},
        "company_name": {"type": "string", "minLength": 1}
      }
    },
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": ["usage_filename", "usage_column"],
      "properties": {
        "usage_filename": {"type": "string", "minLength": 1},
        "usage_column": {"type": "string", "minLength": 1}
      }
    },
    "defaults": {"$ref": "#/$defs/sharedSettings"},
    "sources": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sales", "purchase", "bank", "misc"],
      "properties": {
        "sales": {"$ref": "#/$defs/sourceSettings"},
        "purchase": {"$ref": "#/$defs/purchaseSourceSettings"},
        "bank": {"$ref": "#/$defs/bankSourceSettings"},
        "misc": {"$ref": "#/$defs/sourceSettings"}
      }
    }
  },
  "$defs": {
    "sharedSettings": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "analysis_validation": {"enum": ["strict", "relaxed"]},
        "ocr_workers": {"type": "integer", "minimum": 1},
        "llm_workers": {"type": "integer", "minimum": 1},
        "purpose": {"type": "string", "minLength": 1},
        "cross_company_upload_enabled": {"type": "boolean", "default": false},
        "only_mapped_invoices": {"type": "boolean"}
      }
    },
    "sourceSettings": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "stage"],
      "properties": {
        "enabled": {"type": "boolean"},
        "stage": {"enum": ["ocr", "llm", "prepare", "send", "all"]},
        "analysis_validation": {"enum": ["strict", "relaxed"]},
        "ocr_workers": {"type": "integer", "minimum": 1},
        "llm_workers": {"type": "integer", "minimum": 1},
        "purpose": {"type": "string", "minLength": 1},
        "only_mapped_invoices": {"type": "boolean"}
      }
    },
    "purchaseSourceSettings": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "stage"],
      "properties": {
        "enabled": {"type": "boolean"},
        "stage": {"enum": ["ocr", "llm", "prepare", "send", "all"]},
        "usage_confirmation_enabled": {"type": "boolean", "default": true},
        "analysis_validation": {"enum": ["strict", "relaxed"]},
        "ocr_workers": {"type": "integer", "minimum": 1},
        "llm_workers": {"type": "integer", "minimum": 1},
        "purpose": {"type": "string", "minLength": 1},
        "only_mapped_invoices": {"type": "boolean"}
      }
    },
    "bankSourceSettings": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "stage", "banks", "statement_columns", "exceptions"],
      "properties": {
        "enabled": {"type": "boolean"},
        "stage": {"enum": ["ocr", "llm", "prepare", "send", "all"]},
        "banks": {"$ref": "#/$defs/banks"},
        "statement_columns": {"$ref": "#/$defs/bankStatementColumns"},
        "exceptions": {"$ref": "#/$defs/bankExceptions"},
        "analysis_validation": {"enum": ["strict", "relaxed"]},
        "ocr_workers": {"type": "integer", "minimum": 1},
        "llm_workers": {"type": "integer", "minimum": 1},
        "purpose": {"type": "string", "minLength": 1},
        "only_mapped_invoices": {"type": "boolean"}
      }
    },
    "banks": {
      "type": "object",
      "patternProperties": {
        "^[a-z][a-z0-9_-]*$": {"$ref": "#/$defs/bankConfig"}
      },
      "additionalProperties": false
    },
    "bankExceptions": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    },
    "bankConfig": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "bank_account_number", "split", "remark_template_map"],
      "properties": {
        "enabled": {"type": "boolean"},
        "bank_account_number": {"type": "string", "pattern": "^[0-9]+$"},
        "split": {"$ref": "#/$defs/bankSplit"},
        "remark_template_map": {
          "type": "object",
          "propertyNames": {"minLength": 1},
          "additionalProperties": {"type": "string", "pattern": "^bank/.+_template\\.json$"}
        }
      }
    },
    "bankStatementColumns": {
      "type": "object",
      "patternProperties": {
        "^[a-z][a-z0-9_-]*$": {"$ref": "#/$defs/bankStatementColumnSet"}
      },
      "additionalProperties": false
    },
    "bankSplit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["parts_per_page", "filename_index_length", "filename_index_prefix"],
      "properties": {
        "parts_per_page": {"type": "integer", "minimum": 1, "maximum": 10},
        "filename_index_length": {"type": "integer", "minimum": 6, "maximum": 50},
        "filename_index_prefix": {"type": "string", "pattern": "^[A-Za-z]+$"}
      }
    },
    "bankStatementColumnSet": {
      "type": "object",
      "additionalProperties": false,
      "required": ["index_column", "bank_debit_column", "bank_credit_column", "counterparty_name_column", "remark_column"],
      "properties": {
        "index_column": {"type": ["string", "null"], "minLength": 1},
        "bank_debit_column": {"type": ["string", "null"], "minLength": 1},
        "bank_credit_column": {"type": ["string", "null"], "minLength": 1},
        "counterparty_name_column": {"type": ["string", "null"], "minLength": 1},
        "remark_column": {"type": ["string", "null"], "minLength": 1}
      }
    }
  }
}
