# =============================================================================
# kdzwy_receipt_uploader project-specific ignore rules
# Generic Python, editor and secret patterns are defined in ../.gitignore.
# =============================================================================

# -----------------------------------------------------------------------------
# Local credentials and dynamically discovered account data
# -----------------------------------------------------------------------------
/config/app.json
/config/kdzwy.json
/config/accounts.json
/config/credentials.json
/config/accountbooks.json

# Discovery creates placeholder files such as company_17867515.json.
# Hand-maintained named company configs such as xinghai.json remain trackable.
/config/companies/company_*.json
/config/*.local.json
/config/companies/*.local.json

# Keep distributable examples and hand-authored shared configuration tracked:
#   config/*.example.json
#   config/datasets.json
#   config/pipeline.defaults.json
#   config/template_companies.json
#   config/companies/<company-key>.json

# -----------------------------------------------------------------------------
# Runtime state and isolated per-account/per-company workspaces
# -----------------------------------------------------------------------------
/runtime/
/workspaces/
/logs/
/outputs/
/tmp/
/temp/

# -----------------------------------------------------------------------------
# Real accounting inputs and every generated derivative
# -----------------------------------------------------------------------------
# This includes source PDF/XLSX files, OCR text, DeepSeek analysis, maps,
# receipt.json files, upload state, bank splits, reports and archived files.
/data/inbox/
/data/archive/
/data/processed/
/data/failed/

# Legacy layouts that may still be produced by old scripts.
/data/input/
/generated/
/receipts/
/ocr/
/maps/

# -----------------------------------------------------------------------------
# Run checkpoints, upload records and preload state outside runtime/workspaces
# -----------------------------------------------------------------------------
*.checkpoint.json
*.upload-state.json
*.preload-state.json
*.run-state.json
run.jsonl
run.before-upload-reset.*.jsonl

# Templates, source code, batch files, scripts and example configs are
# intentionally NOT ignored.
