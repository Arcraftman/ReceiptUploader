    "sales_map_file": "data/inbox/{company}/{month}/generated/maps/{source}/sales_map.json",
    "sales_map_report_file": "data/inbox/{company}/{month}/generated/maps/{source}/sales_map.report.json",
    "purchase_map_file": "data/inbox/{company}/{month}/generated/maps/{source}/purchase_map.json",
    "purchase_map_report_file": "data/inbox/{company}/{month}/generated/maps/{source}/purchase_map.report.json",
    "bank_maps_dir": "data/inbox/{company}/{month}/generated/maps/{source}/bank",
    "bank_map_path_pattern": "data/inbox/{company}/{month}/generated/maps/{source}/bank/{bank_account}/bank_map.json",
    "bank_map_report_path_pattern": "data/inbox/{company}/{month}/generated/maps/{source}/bank/{bank_account}/bank_map.report.json",
    "misc_map_file": "data/inbox/{company}/{month}/generated/maps/{source}/misc_map.json",
