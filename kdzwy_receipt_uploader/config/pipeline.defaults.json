    "receipt_dir": "data/inbox/{company}/{month}/generated/receipts/{source}",
    "receipt_dir_sales_map": "data/inbox/{company}/{month}/generated/receipts/{source}",
    "receipt_dir_bank_map_pattern": "data/inbox/{company}/{month}/generated/receipts/{source}/{bank_account}",
    "receipt_dir_misc_map": "data/inbox/{company}/{month}/generated/receipts/{source}",
    "receipts_ocr_dir": "data/inbox/{company}/{month}/generated/ocr/{source}",
    "receipt_report_file": "data/inbox/{company}/{month}/generated/receipts/{source}/receipt_generation.report.json",
    "preupload_review_file": "data/inbox/{company}/{month}/generated/maps/{source}/preupload_review.report.json"
